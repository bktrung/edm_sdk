{
  "attributes": [
    {
      "attribute": "f1attempt",
      "type": "int",
      "setBy": "core"
    },
    {
      "attribute": "f1causationid",
      "type": "string",
      "setBy": "core"
    },
    {
      "attribute": "f1correlationid",
      "type": "string",
      "setBy": "producer"
    },
    {
      "attribute": "f1deatherror",
      "type": "string",
      "setBy": "core"
    },
    {
      "attribute": "f1deathreason",
      "type": "enum (string)",
      "setBy": "core",
      "enum": [
        "max_attempts",
        "terminal",
        "panic",
        "decode",
        "expired",
        "poison",
        "unmatched"
      ]
    },
    {
      "attribute": "f1deathtime",
      "type": "RFC3339",
      "setBy": "core"
    },
    {
      "attribute": "f1duetime",
      "type": "RFC3339",
      "setBy": "core"
    },
    {
      "attribute": "f1expiry",
      "type": "RFC3339",
      "setBy": "producer"
    },
    {
      "attribute": "f1idempotencykey",
      "type": "string",
      "setBy": "producer or core"
    },
    {
      "attribute": "f1maxattempts",
      "type": "int",
      "setBy": "producer (optional cap) or core (on first retry copy)"
    },
    {
      "attribute": "f1originaldest",
      "type": "string",
      "setBy": "core"
    },
    {
      "attribute": "f1partitionkey",
      "type": "string",
      "setBy": "producer"
    },
    {
      "attribute": "f1priority",
      "type": "enum (string)",
      "setBy": "producer",
      "enum": [
        "high",
        "normal",
        "low"
      ]
    },
    {
      "attribute": "f1producer",
      "type": "string",
      "setBy": "core"
    }
  ]
}
